{
  "name": "jinja-college-cms",
  "version": "1.0.0",
  "description": "Jinja College Class Monitoring System",
  "main": "main.js",
  "author": "Jinja College",
  "scripts": {
    "start": "react-scripts start",
    "start:desktop": "node node_modules/electron/cli.js .",
    "react-start": "react-scripts start",
    "build": "react-scripts build",
    "build:mobile": "react-scripts build && npx cap sync android",
    "git:setup": "powershell -ExecutionPolicy Bypass -File scripts\\setup-git-portable.ps1",
    "state:lock": "powershell -ExecutionPolicy Bypass -File scripts\\state-lock.ps1",
    "state:lock:skip-build": "powershell -ExecutionPolicy Bypass -File scripts\\state-lock.ps1 -SkipBuild",
    "prepare:android": "npx cap add android || true && npx cap sync android",
    "deploy:site": "gh-pages -d SITE",
    "release:windows": "powershell -File scripts\\release-windows.ps1",
    "package": "npm run build && electron-builder build --win --publish never",
    "package-dir": "npm run build && electron-builder build --win --dir"
  },
  "build": {
    "appId": "com.jinjacollege.cms",
    "productName": "Jinja College CMS",
    "directories": {
      "output": "dist"
    },
    "files": [
      "build/**/*",
      "main.js",
      "package.json",
      "public/electron.js",
      "public/icon.ico",
      "public/icon.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Jinja College CMS",
      "installerIcon": "public/icon.ico",
      "uninstallerIcon": "public/icon.ico"
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.2.0",
    "@capacitor/cli": "^8.2.0",
    "@capacitor/core": "^8.2.0",
    "@supabase/supabase-js": "^2.39.0",
    "lucide-react": "^0.263.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "react-scripts": "5.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^28.3.3",
    "electron-builder": "^24.9.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "gh-pages": "^6.3.0",
    "wait-on": "^7.2.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
